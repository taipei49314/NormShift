{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://normshift.dev/schemas/command-log-v1.schema.json",
  "title": "NormShift retained command log v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "gate",
    "required",
    "argv",
    "cwd",
    "started_at",
    "finished_at",
    "exit_code",
    "stdout",
    "stderr"
  ],
  "properties": {
    "schema_version": {"const": "normshift-command-log/v1"},
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "gate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "required": {"const": true},
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "cwd": {"type": "string", "minLength": 1, "maxLength": 1024},
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "exit_code": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "stdout": {"type": "string", "maxLength": 16777216},
    "stderr": {"type": "string", "maxLength": 16777216}
  }
}
