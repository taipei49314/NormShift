{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://normshift.local/schemas/report.schema.json",
  "title": "NormShiftReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "profile",
    "old_document",
    "new_document",
    "old_requirements",
    "new_requirements",
    "changes",
    "summary",
    "integrity"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "tool_version": { "type": "string" },
    "profile": { "type": "string", "enum": ["rfc2119", "whatwg"] },
    "old_document": { "type": "object" },
    "new_document": { "type": "object" },
    "old_requirements": { "type": "array", "items": { "type": "object" } },
    "new_requirements": { "type": "array", "items": { "type": "object" } },
    "changes": { "type": "array", "items": { "type": "object" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_requirement_count",
        "new_requirement_count",
        "change_count",
        "classification_counts"
      ],
      "properties": {
        "old_requirement_count": { "type": "integer", "minimum": 0 },
        "new_requirement_count": { "type": "integer", "minimum": 0 },
        "change_count": { "type": "integer", "minimum": 0 },
        "classification_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "content_sha256"],
      "properties": {
        "alg": { "type": "string", "const": "sha256" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
