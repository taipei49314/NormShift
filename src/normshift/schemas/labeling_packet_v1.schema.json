{
  "$comment": "Structural JSON Schema validation alone does not verify canonical bytes, artifact hashes, reviewer independence, exact-root custody, blind-split invariants, or grant M1/M2 acceptance; use `normshift governance verify-*` with independent trust anchors.",
  "$defs": {
    "EvaluationTask": {
      "enum": [
        "M1_REQUIREMENT_EXTRACTION",
        "M1_MODALITY",
        "M1_REGION",
        "M1_FAMILY_DETECTION",
        "M2_IDENTITY",
        "M2_RELATION",
        "M2_CHANGE",
        "M2_DEFINITION_XREF",
        "M2_AMBIGUITY_ROUTING"
      ],
      "title": "EvaluationTask",
      "type": "string"
    },
    "NeutralityAttestation": {
      "additionalProperties": false,
      "properties": {
        "contains_candidate_prediction": {
          "const": false,
          "title": "Contains Candidate Prediction",
          "type": "boolean"
        },
        "contains_model_confidence": {
          "const": false,
          "title": "Contains Model Confidence",
          "type": "boolean"
        },
        "contains_model_proposal": {
          "const": false,
          "title": "Contains Model Proposal",
          "type": "boolean"
        },
        "created_before_prediction_access": {
          "const": true,
          "title": "Created Before Prediction Access",
          "type": "boolean"
        }
      },
      "required": [
        "contains_model_proposal",
        "contains_model_confidence",
        "contains_candidate_prediction",
        "created_before_prediction_access"
      ],
      "title": "NeutralityAttestation",
      "type": "object"
    },
    "PacketItem": {
      "additionalProperties": false,
      "properties": {
        "allowed_classes": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Allowed Classes",
          "type": "array"
        },
        "evaluation_slot": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Evaluation Slot",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "item_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Item Key",
          "type": "string"
        },
        "portable_locators": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Portable Locators",
          "type": "array"
        },
        "source_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Source Sha256S",
          "type": "array"
        },
        "task": {
          "$ref": "#/$defs/EvaluationTask"
        }
      },
      "required": [
        "item_key",
        "task",
        "evaluation_slot",
        "source_sha256s",
        "portable_locators",
        "evidence_sha256",
        "allowed_classes"
      ],
      "title": "PacketItem",
      "type": "object"
    }
  },
  "$id": "https://normshift.example/schemas/labeling_packet_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset_split": {
      "enum": [
        "DEVELOPMENT",
        "BLIND_HOLDOUT"
      ],
      "title": "Dataset Split",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/PacketItem"
      },
      "maxItems": 250000,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "kind": {
      "const": "normshift-neutral-labeling-packet",
      "title": "Kind",
      "type": "string"
    },
    "neutrality": {
      "$ref": "#/$defs/NeutralityAttestation"
    },
    "packet_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Packet Id",
      "type": "string"
    },
    "packet_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Packet Version",
      "type": "string"
    },
    "policy_id": {
      "const": "normshift-m1-m2-prereg-v1",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "prepared_at_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Prepared At Utc",
      "type": "string"
    },
    "prepared_by_reviewer_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Prepared By Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Sha256",
      "type": "string"
    },
    "split_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Split Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "policy_id",
    "policy_sha256",
    "packet_id",
    "packet_version",
    "dataset_split",
    "source_manifest_sha256",
    "split_manifest_sha256",
    "prepared_by_reviewer_id",
    "prepared_at_utc",
    "neutrality",
    "items"
  ],
  "title": "LabelingPacket",
  "type": "object"
}
