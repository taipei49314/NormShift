{
  "$comment": "Structural interchange schema only. Arithmetic, canonical item-key, graph, timestamp, aggregate, and frozen-policy invariants require validation and recomputation by the exact hash-bound NormShift scorer/models; JSON Schema validation alone never grants acceptance.",
  "$defs": {
    "DatasetSplit": {
      "enum": [
        "DEVELOPMENT",
        "BLIND_HOLDOUT"
      ],
      "title": "DatasetSplit",
      "type": "string"
    },
    "DecisionOutcome": {
      "enum": [
        "ACCEPTED",
        "ABSTAINED",
        "CONFLICT"
      ],
      "title": "DecisionOutcome",
      "type": "string"
    },
    "EvaluationFamily": {
      "enum": [
        "RFC",
        "W3C_TR",
        "WHATWG"
      ],
      "title": "EvaluationFamily",
      "type": "string"
    },
    "EvaluationSource": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Chain Id",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/EvaluationFamily"
        },
        "lineage_sequence": {
          "minimum": 1,
          "title": "Lineage Sequence",
          "type": "integer"
        },
        "origin": {
          "$ref": "#/$defs/SourceOrigin"
        },
        "portable_source_ref": {
          "maxLength": 768,
          "minLength": 1,
          "title": "Portable Source Ref",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "standard_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Standard Id",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "family",
        "origin",
        "raw_sha256",
        "standard_id",
        "version",
        "chain_id",
        "lineage_sequence",
        "portable_source_ref"
      ],
      "title": "EvaluationSource",
      "type": "object"
    },
    "EvaluationTask": {
      "enum": [
        "M1_REQUIREMENT_EXTRACTION",
        "M1_MODALITY",
        "M1_REGION",
        "M1_FAMILY_DETECTION",
        "M2_IDENTITY",
        "M2_RELATION",
        "M2_CHANGE",
        "M2_DEFINITION_XREF",
        "M2_AMBIGUITY_ROUTING"
      ],
      "title": "EvaluationTask",
      "type": "string"
    },
    "GoldItem": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Decision Id",
          "type": "string"
        },
        "evaluation_slot": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Evaluation Slot",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "expected_class": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Expected Class",
          "type": "string"
        },
        "item_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Item Key",
          "type": "string"
        },
        "label_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Label Id",
          "type": "string"
        },
        "modal_distractor": {
          "default": false,
          "title": "Modal Distractor",
          "type": "boolean"
        },
        "portable_locators": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Portable Locators",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "task": {
          "$ref": "#/$defs/EvaluationTask"
        }
      },
      "required": [
        "item_key",
        "label_id",
        "decision_id",
        "task",
        "evaluation_slot",
        "expected_class",
        "source_ids",
        "portable_locators",
        "evidence_sha256"
      ],
      "title": "GoldItem",
      "type": "object"
    },
    "LabelDecision": {
      "additionalProperties": false,
      "properties": {
        "adjudicator_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Adjudicator Id",
          "type": "string"
        },
        "decided_at_utc": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Decided At Utc",
          "type": "string"
        },
        "decided_class": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided Class"
        },
        "decision": {
          "$ref": "#/$defs/DecisionOutcome"
        },
        "decision_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Decision Id",
          "type": "string"
        },
        "evaluation_slot": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Evaluation Slot",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "item_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Item Key",
          "type": "string"
        },
        "label_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Label Id",
          "type": "string"
        },
        "portable_locators": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Portable Locators",
          "type": "array"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reviewer_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Reviewer Ids",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "task": {
          "$ref": "#/$defs/EvaluationTask"
        }
      },
      "required": [
        "decision_id",
        "label_id",
        "item_key",
        "task",
        "evaluation_slot",
        "source_ids",
        "portable_locators",
        "evidence_sha256",
        "reviewer_ids",
        "adjudicator_id",
        "decision",
        "reason",
        "decided_at_utc"
      ],
      "title": "LabelDecision",
      "type": "object"
    },
    "ReviewEnvelope": {
      "additionalProperties": false,
      "properties": {
        "adjudicator_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Adjudicator Id",
          "type": "string"
        },
        "decided_at_utc": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Decided At Utc",
          "type": "string"
        },
        "labeler_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Labeler Ids",
          "type": "array"
        },
        "labels_hash_frozen": {
          "const": true,
          "title": "Labels Hash Frozen",
          "type": "boolean"
        },
        "predictions_viewed_before_freeze": {
          "const": false,
          "title": "Predictions Viewed Before Freeze",
          "type": "boolean"
        }
      },
      "required": [
        "labeler_ids",
        "adjudicator_id",
        "predictions_viewed_before_freeze",
        "labels_hash_frozen",
        "decided_at_utc"
      ],
      "title": "ReviewEnvelope",
      "type": "object"
    },
    "SourceOrigin": {
      "enum": [
        "ACTUAL",
        "SYNTHETIC"
      ],
      "title": "SourceOrigin",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Dataset Version",
      "type": "string"
    },
    "decision_ledger_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Ledger Sha256",
      "type": "string"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/LabelDecision"
      },
      "maxItems": 300000,
      "minItems": 1,
      "title": "Decisions",
      "type": "array"
    },
    "frozen_at_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Frozen At Utc",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/GoldItem"
      },
      "maxItems": 250000,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "kind": {
      "const": "normshift-acceptance-gold",
      "title": "Kind",
      "type": "string"
    },
    "policy_id": {
      "const": "normshift-m1-m2-prereg-v1",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/ReviewEnvelope"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scorer_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scorer Manifest Sha256",
      "type": "string"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Sha256",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/EvaluationSource"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "split": {
      "$ref": "#/$defs/DatasetSplit"
    },
    "split_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Split Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "policy_id",
    "policy_sha256",
    "scorer_manifest_sha256",
    "dataset_id",
    "dataset_version",
    "split",
    "source_manifest_sha256",
    "split_manifest_sha256",
    "decision_ledger_sha256",
    "frozen_at_utc",
    "review",
    "sources",
    "items",
    "decisions"
  ],
  "title": "GoldDocument",
  "type": "object"
}
