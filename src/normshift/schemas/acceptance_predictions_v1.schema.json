{
  "$comment": "Structural interchange schema only. Arithmetic, canonical item-key, graph, timestamp, aggregate, and frozen-policy invariants require validation and recomputation by the exact hash-bound NormShift scorer/models; JSON Schema validation alone never grants acceptance.",
  "$defs": {
    "CandidateBinding": {
      "additionalProperties": false,
      "properties": {
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "sdist_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sdist Sha256",
          "type": "string"
        },
        "source_zip_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Zip Sha256",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Tree",
          "type": "string"
        },
        "wheel_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Wheel Sha256",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree",
        "wheel_sha256",
        "sdist_sha256",
        "source_zip_sha256",
        "bundle_sha256"
      ],
      "title": "CandidateBinding",
      "type": "object"
    },
    "EvaluationTask": {
      "enum": [
        "M1_REQUIREMENT_EXTRACTION",
        "M1_MODALITY",
        "M1_REGION",
        "M1_FAMILY_DETECTION",
        "M2_IDENTITY",
        "M2_RELATION",
        "M2_CHANGE",
        "M2_DEFINITION_XREF",
        "M2_AMBIGUITY_ROUTING"
      ],
      "title": "EvaluationTask",
      "type": "string"
    },
    "PredictionItem": {
      "additionalProperties": false,
      "properties": {
        "evaluation_slot": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Evaluation Slot",
          "type": "string"
        },
        "item_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Item Key",
          "type": "string"
        },
        "portable_locators": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Portable Locators",
          "type": "array"
        },
        "predicted_class": {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Predicted Class",
          "type": "string"
        },
        "source_sha256s": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Source Sha256S",
          "type": "array"
        },
        "task": {
          "$ref": "#/$defs/EvaluationTask"
        }
      },
      "required": [
        "item_key",
        "task",
        "evaluation_slot",
        "source_sha256s",
        "portable_locators",
        "predicted_class"
      ],
      "title": "PredictionItem",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/CandidateBinding"
    },
    "dataset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Dataset Version",
      "type": "string"
    },
    "generated_at_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Generated At Utc",
      "type": "string"
    },
    "gold_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Gold Sha256",
      "type": "string"
    },
    "kind": {
      "const": "normshift-acceptance-predictions",
      "title": "Kind",
      "type": "string"
    },
    "policy_id": {
      "const": "normshift-m1-m2-prereg-v1",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "predictions": {
      "items": {
        "$ref": "#/$defs/PredictionItem"
      },
      "maxItems": 300000,
      "title": "Predictions",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scorer_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scorer Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "policy_id",
    "policy_sha256",
    "scorer_manifest_sha256",
    "dataset_id",
    "dataset_version",
    "gold_sha256",
    "candidate",
    "generated_at_utc",
    "predictions"
  ],
  "title": "PredictionDocument",
  "type": "object"
}
