{
  "$comment": "Structural JSON Schema validation alone does not verify canonical bytes, artifact hashes, reviewer independence, exact-root custody, blind-split invariants, or grant M1/M2 acceptance; use `normshift governance verify-*` with independent trust anchors.",
  "$defs": {
    "EvaluationTask": {
      "enum": [
        "M1_REQUIREMENT_EXTRACTION",
        "M1_MODALITY",
        "M1_REGION",
        "M1_FAMILY_DETECTION",
        "M2_IDENTITY",
        "M2_RELATION",
        "M2_CHANGE",
        "M2_DEFINITION_XREF",
        "M2_AMBIGUITY_ROUTING"
      ],
      "title": "EvaluationTask",
      "type": "string"
    },
    "IndependenceAttestation": {
      "additionalProperties": false,
      "properties": {
        "implemented_evaluated_system": {
          "const": false,
          "title": "Implemented Evaluated System",
          "type": "boolean"
        },
        "viewed_candidate_predictions": {
          "const": false,
          "title": "Viewed Candidate Predictions",
          "type": "boolean"
        },
        "viewed_model_confidence": {
          "const": false,
          "title": "Viewed Model Confidence",
          "type": "boolean"
        },
        "viewed_model_proposals": {
          "const": false,
          "title": "Viewed Model Proposals",
          "type": "boolean"
        },
        "viewed_other_labeler_answers": {
          "const": false,
          "title": "Viewed Other Labeler Answers",
          "type": "boolean"
        },
        "worked_independently": {
          "const": true,
          "title": "Worked Independently",
          "type": "boolean"
        }
      },
      "required": [
        "worked_independently",
        "viewed_other_labeler_answers",
        "viewed_model_proposals",
        "viewed_model_confidence",
        "viewed_candidate_predictions",
        "implemented_evaluated_system"
      ],
      "title": "IndependenceAttestation",
      "type": "object"
    },
    "LabelResponse": {
      "additionalProperties": false,
      "properties": {
        "decided_at_utc": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Decided At Utc",
          "type": "string"
        },
        "evaluation_slot": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Evaluation Slot",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "item_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Item Key",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/LabelResponseOutcome"
        },
        "portable_locators": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Portable Locators",
          "type": "array"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "selected_class": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Class"
        },
        "source_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Source Sha256S",
          "type": "array"
        },
        "task": {
          "$ref": "#/$defs/EvaluationTask"
        }
      },
      "required": [
        "item_key",
        "task",
        "evaluation_slot",
        "source_sha256s",
        "portable_locators",
        "evidence_sha256",
        "outcome",
        "reason",
        "decided_at_utc"
      ],
      "title": "LabelResponse",
      "type": "object"
    },
    "LabelResponseOutcome": {
      "enum": [
        "LABELED",
        "ABSTAINED",
        "AMBIGUOUS"
      ],
      "title": "LabelResponseOutcome",
      "type": "string"
    }
  },
  "$id": "https://normshift.example/schemas/label_submission_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "independence": {
      "$ref": "#/$defs/IndependenceAttestation"
    },
    "kind": {
      "const": "normshift-independent-label-submission",
      "title": "Kind",
      "type": "string"
    },
    "labeler_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Labeler Id",
      "type": "string"
    },
    "packet_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Packet Sha256",
      "type": "string"
    },
    "policy_id": {
      "const": "normshift-m1-m2-prereg-v1",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "responses": {
      "items": {
        "$ref": "#/$defs/LabelResponse"
      },
      "maxItems": 250000,
      "minItems": 1,
      "title": "Responses",
      "type": "array"
    },
    "review_round_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Review Round Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "submission_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Submission Id",
      "type": "string"
    },
    "submitted_at_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Submitted At Utc",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "policy_id",
    "policy_sha256",
    "submission_id",
    "packet_sha256",
    "review_round_id",
    "labeler_id",
    "independence",
    "submitted_at_utc",
    "responses"
  ],
  "title": "LabelSubmission",
  "type": "object"
}
