{
  "schema_version": "1.0.0",
  "policy_name": "normshift-official-standards",
  "allow_https_only": true,
  "max_redirects": 5,
  "max_bytes": 52428800,
  "allowed_content_types": [
    "text/html",
    "application/xhtml+xml",
    "application/xml",
    "text/xml",
    "application/json",
    "text/plain"
  ],
  "domains": {
    "ietf": {
      "hosts": [
        "www.rfc-editor.org",
        "rfc-editor.org",
        "www.ietf.org",
        "datatracker.ietf.org"
      ]
    },
    "w3c": {
      "hosts": ["www.w3.org", "w3c.github.io"]
    },
    "whatwg": {
      "hosts": [
        "html.spec.whatwg.org",
        "streams.spec.whatwg.org",
        "fetch.spec.whatwg.org",
        "dom.spec.whatwg.org",
        "url.spec.whatwg.org"
      ]
    }
  },
  "redirect_policy": {
    "require_final_host_allowlisted": true
  },
  "offline_after_acquire": true
}
