# Portable evidence requires byte-stable fixtures and reports across platforms.
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sha256 text eol=lf
*.lock text eol=lf

# This exact-root evidence inventory hashes curator-captured CRLF header bytes.
# Disable all checkout/index transformations for every file under this root.
/corpus/m1-development/** -text -eol
/corpus/m1-development/curation-headers/** -text whitespace=cr-at-eol,-blank-at-eof
