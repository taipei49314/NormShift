{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://normshift.local/schemas/change.schema.json",
  "title": "Change",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "old_requirement_id",
    "new_requirement_id",
    "classification",
    "confidence",
    "classification_reasons",
    "evidence_hashes"
  ],
  "properties": {
    "change_id": { "type": "string" },
    "old_requirement_id": { "type": ["string", "null"] },
    "new_requirement_id": { "type": ["string", "null"] },
    "classification": {
      "type": "string",
      "enum": [
        "UNCHANGED",
        "MOVED",
        "EDITORIAL",
        "ADDED",
        "REMOVED",
        "STRENGTHENED",
        "WEAKENED",
        "POLARITY_FLIP",
        "CONDITION_ADDED",
        "CONDITION_REMOVED",
        "EXCEPTION_ADDED",
        "EXCEPTION_REMOVED",
        "SPLIT",
        "MERGED",
        "AMBIGUOUS"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "classification_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "old_source_locator": { "type": ["string", "null"] },
    "new_source_locator": { "type": ["string", "null"] },
    "old_text": { "type": ["string", "null"] },
    "new_text": { "type": ["string", "null"] },
    "modality_transition": { "type": ["string", "null"] },
    "evidence_hashes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "alignment_score": { "type": ["object", "null"] },
    "old_section_path": { "type": ["string", "null"] },
    "new_section_path": { "type": ["string", "null"] }
  }
}
