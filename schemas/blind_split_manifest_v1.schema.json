{
  "$comment": "Structural JSON Schema validation alone does not verify canonical bytes, artifact hashes, reviewer independence, exact-root custody, blind-split invariants, or grant M1/M2 acceptance; use `normshift governance verify-*` with independent trust anchors.",
  "$defs": {
    "BlindSplitDocument": {
      "additionalProperties": false,
      "properties": {
        "derived_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Derived Sha256S",
          "type": "array"
        },
        "family": {
          "$ref": "#/$defs/EvaluationFamily"
        },
        "m1_in_scope": {
          "title": "M1 In Scope",
          "type": "boolean"
        },
        "m2_in_scope": {
          "title": "M2 In Scope",
          "type": "boolean"
        },
        "m2_lineage_chain_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "M2 Lineage Chain Id"
        },
        "portable_source_ref": {
          "maxLength": 768,
          "minLength": 1,
          "title": "Portable Source Ref",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/DatasetSplit"
        },
        "standard_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Standard Id",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "family",
        "standard_id",
        "version",
        "raw_sha256",
        "derived_sha256s",
        "portable_source_ref",
        "m1_in_scope",
        "m2_in_scope",
        "split"
      ],
      "title": "BlindSplitDocument",
      "type": "object"
    },
    "BlindnessAttestation": {
      "additionalProperties": false,
      "properties": {
        "fixture_name_path_url_or_hash_special_cases_added": {
          "const": false,
          "title": "Fixture Name Path Url Or Hash Special Cases Added",
          "type": "boolean"
        },
        "holdout_gold_visible_to_implementation_before_candidate_freeze": {
          "const": false,
          "title": "Holdout Gold Visible To Implementation Before Candidate Freeze",
          "type": "boolean"
        },
        "holdout_membership_visible_to_implementation_before_candidate_freeze": {
          "const": false,
          "title": "Holdout Membership Visible To Implementation Before Candidate Freeze",
          "type": "boolean"
        },
        "holdout_predictions_visible_to_implementation_before_candidate_freeze": {
          "const": false,
          "title": "Holdout Predictions Visible To Implementation Before Candidate Freeze",
          "type": "boolean"
        }
      },
      "required": [
        "holdout_membership_visible_to_implementation_before_candidate_freeze",
        "holdout_gold_visible_to_implementation_before_candidate_freeze",
        "holdout_predictions_visible_to_implementation_before_candidate_freeze",
        "fixture_name_path_url_or_hash_special_cases_added"
      ],
      "title": "BlindnessAttestation",
      "type": "object"
    },
    "CandidateArtifacts": {
      "additionalProperties": false,
      "properties": {
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "sdist_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sdist Sha256",
          "type": "string"
        },
        "source_zip_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Zip Sha256",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Tree",
          "type": "string"
        },
        "wheel_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Wheel Sha256",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree",
        "wheel_sha256",
        "sdist_sha256",
        "source_zip_sha256",
        "bundle_sha256"
      ],
      "title": "CandidateArtifacts",
      "type": "object"
    },
    "CandidateFreeze": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateArtifacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "frozen_at_utc": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frozen At Utc"
        },
        "holdout_opened_at_utc": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Holdout Opened At Utc"
        },
        "predictions_started_at_utc": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Predictions Started At Utc"
        },
        "status": {
          "$ref": "#/$defs/CandidateFreezeStatus"
        }
      },
      "required": [
        "status",
        "candidate",
        "frozen_at_utc",
        "holdout_opened_at_utc",
        "predictions_started_at_utc"
      ],
      "title": "CandidateFreeze",
      "type": "object"
    },
    "CandidateFreezeStatus": {
      "enum": [
        "NOT_FROZEN",
        "FROZEN"
      ],
      "title": "CandidateFreezeStatus",
      "type": "string"
    },
    "DatasetSplit": {
      "enum": [
        "DEVELOPMENT",
        "BLIND_HOLDOUT"
      ],
      "title": "DatasetSplit",
      "type": "string"
    },
    "EvaluationFamily": {
      "enum": [
        "RFC",
        "W3C_TR",
        "WHATWG"
      ],
      "title": "EvaluationFamily",
      "type": "string"
    }
  },
  "$id": "https://normshift.example/schemas/blind_split_manifest_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blindness": {
      "$ref": "#/$defs/BlindnessAttestation"
    },
    "candidate_freeze": {
      "$ref": "#/$defs/CandidateFreeze"
    },
    "created_at_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At Utc",
      "type": "string"
    },
    "custodian_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Custodian Ids",
      "type": "array"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/BlindSplitDocument"
      },
      "maxItems": 10000,
      "minItems": 3,
      "title": "Documents",
      "type": "array"
    },
    "implementation_author_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Implementation Author Ids",
      "type": "array"
    },
    "kind": {
      "const": "normshift-blind-split-manifest",
      "title": "Kind",
      "type": "string"
    },
    "policy_id": {
      "const": "normshift-m1-m2-prereg-v1",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Sha256",
      "type": "string"
    },
    "split_frozen_at_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Split Frozen At Utc",
      "type": "string"
    },
    "split_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Split Id",
      "type": "string"
    },
    "split_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Split Version",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "policy_id",
    "policy_sha256",
    "split_id",
    "split_version",
    "source_manifest_sha256",
    "custodian_ids",
    "implementation_author_ids",
    "created_at_utc",
    "split_frozen_at_utc",
    "blindness",
    "candidate_freeze",
    "documents"
  ],
  "title": "BlindSplitManifest",
  "type": "object"
}
